# Пример. Скопируй этот файл в keystore.properties (в этой же папке android) и впиши свои данные.
# keystore.properties в Git НЕ попадает. Пути пиши через прямой слэш /.
# Можно использовать тот же ключ, что и для JOL-Bilim.
storeFile=C:/Users/ASUS/Desktop/JOL-keys/jol-bilim-upload.jks
storePassword=ПАРОЛЬ_ХРАНИЛИЩА
keyAlias=upload
keyPassword=ПАРОЛЬ_КЛЮЧА
