android/.gradle/
android/build/
android/app/build/
android/app/release/
android/.idea/
android/local.properties
android/capacitor-cordova-android-plugins/build/

# Ключ подписи и пароли — НИКОГДА не в Git!
*.jks
*.keystore
android/keystore.properties

